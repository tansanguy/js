# Runtime logs and debug output
outputs/logs/*.log
outputs/debug/*

# Python cache
__pycache__/
*.py[cod]
.venv/

# Local OS files
.DS_Store

# Simulation run artifacts
# Keep raw SUMO runs outside git. Curated final summaries can be force-added
# only when they are intended as report snapshots.
runs/
results/raw/
results/metrics/*/
#!results/metrics/parameter_input_sim/
#!results/metrics/parameter_input_sim/**
results/metrics/*.csv
results/metrics/*.json
results/metrics/*.xml
results/html/*.html

# Visualization deliverables shared on GitHub.
# Top-level results/html/*.html is regenerable and stays ignored (above).
# Self-contained HTML report snapshots meant for sharing (a few MB) go under
# results/html/shared/, which is tracked. Do NOT put raw runs/ FCD here
# (tens of MB per file) — share those out-of-band (cloud / Release / Git LFS).
!results/html/shared/
!results/html/shared/**

# BO-generated parameter suggestions are artifacts. Promote a selected CSV to a
# named config file before treating it as a reproducible input.
configs/generated/*.csv

# Raw traffic API snapshots are provenance inputs for local audit, not curated
# repository artifacts.
09\ Compact\ Corridor\ Baseline/tdata_signal/api_snapshots/*.jsonl

# Generated demand variants are artifacts unless explicitly whitelisted as the
# final manifest input.
data_prepared/demand/*_scale_*.rou.xml
data_prepared/demand/*_sustained_3600.rou.xml
!data_prepared/demand/background_routes_am_imputed_a17_a19_warm0p15_sustain0p05_seed002_sustained_3600.rou.xml

# Local archives
local_archive/

# Visualization: generated mock FCD fixtures (regenerate via mock/make_mock_fcd.py)
04_visualize/mock/data/
